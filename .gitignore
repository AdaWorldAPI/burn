target
# These are backup files generated by rustfmt
**/*.rs.bk
.DS_Store

.dir-locals.el
.idea
.vscode
.vs
.fleet
.ipynb_checkpoints/

# Build output directory
out

# Virtual Environment of Python
.venv
uv.lock

# Nix direnv
.envrc
.direnv

# tags files
tags

examples/**/Cargo.lock
# The workspace tracks no lockfile: a committed lock is a second authority on
# dependency versions and re-conflicts on every upstream resync. Bins that need
# a reproducible build pin it at the deploy edge, not in-tree.
/Cargo.lock

# rustc self-profiling files
*.mm_profdata
*.stacks_folded
*profiler.json
# linker maps
*.map
